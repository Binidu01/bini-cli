{
  "name": "create-bini-app",
  "type": "module",
  "version": "10.0.12",
  "description": "Bini.js - a modular full-stack React framework for web, desktop, and mobile from one codebase.",
  "keywords": [
    "bini",
    "binijs",
    "bini.js",
    "bini-framework",
    "create-bini-app",
    "create-app",
    "framework",
    "react-framework",
    "full-stack",
    "fullstack",
    "scaffold",
    "scaffolder",
    "project-generator",
    "starter",
    "cli",
    "react",
    "vite",
    "hono",
    "typescript",
    "tailwindcss",
    "file-based-routing",
    "ssg",
    "tauri",
    "cross-platform",
    "desktop",
    "mobile",
    "android",
    "ios"
  ],
  "bin": {
    "create-bini-app": "dist/index.js",
    "bini": "dist/index.js",
    "binijs": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node dist/index.js --version",
    "prepublishOnly": "npm run typecheck && npm run build && node dist/index.js --version"
  },
  "homepage": "https://bini.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Binidu01/bini-cli.git"
  },
